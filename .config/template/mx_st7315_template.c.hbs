/**
  * @brief initialize the IO layer.
  * @param  pio      pointer to the part IO structure.
  * @retval error status.
  */
int32_t st7315_io_init(st7315_io_t *pio)
{
  /* Part Status */
  int32_t ret = 0;

  switch (pio->id)
  {
{{#each @root.st7315_instances}}
{{assign 'ctx' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
{{#with @root.ctx}}
    case ST7315_{{@index}}:
{{#if (eq info.interface 'SPI')}}
      pio->phspi    = ST7315_{{@index}}_SPI_GETHANDLE();
      pio->rst_port = ST7315_{{@index}}_RST_GPIO_PORT;
      pio->rst_pin  = ST7315_{{@index}}_RST_GPIO_PIN;
      pio->cs_port  = ST7315_{{@index}}_CS_GPIO_PORT;
      pio->cs_pin   = ST7315_{{@index}}_CS_GPIO_PIN;
      pio->dc_port  = ST7315_{{@index}}_DC_GPIO_PORT;
      pio->dc_pin   = ST7315_{{@index}}_DC_GPIO_PIN;
{{/if}}
      break;
{{/with}} {{!-- @root.ctx --}}
{{/each}} {{!-- @root.st7315_instances --}}
    default:
      /* Error -- Unknown ID */
      ret = -1;
      break;
  }

  return ret;
}

